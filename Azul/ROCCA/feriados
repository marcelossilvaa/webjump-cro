  /* ──────────────────────────────────────────────
     Bar HTML
  ────────────────────────────────────────────── */
  function injectBar(target) {
    var bar = document.createElement('div');
    bar.id = OVERLAY_ID;

    var list = document.createElement('div');
    list.className = 'fhb-list';

    for (var i = 0; i < holidays.length; i++) {
      var h = holidays[i];
      var item = document.createElement('a');
      item.className = 'fhb-item';
      item.href = 'https://passagens.voeazul.com.br/pt/feriados';
      item.target = '_blank';
      item.rel = 'noopener noreferrer';
      item.innerHTML = h.icon + '<span>' + h.label + '</span>';
      list.appendChild(item);
    }

    bar.appendChild(list);
    target.insertAdjacentElement('afterend', bar);
    startCarousel(list);
  }

  /* ──────────────────────────────────────────────
     Carousel auto-scroll + drag manual
  ────────────────────────────────────────────── */
  function startCarousel(list) {
    var DELAY        = 3000;   // ms entre cada passo automático
    var STEP_PX      = 150;    // pixels por passo automático
    var SMOOTH_MS    = 400;    // duração da animação suave
    var RESUME_DELAY = 3000;   // ms para retomar o auto-scroll após interação manual
    var paused       = false;
    var resumeTimer  = null;

    /* ── auto-scroll suave ── */
    function smoothScrollBy(el, delta) {
      var start     = el.scrollLeft;
      var end       = start + delta;
      var maxScroll = el.scrollWidth - el.clientWidth;
      if (end >= maxScroll - 1) end = 0;

      var startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var p = Math.min((ts - startTime) / SMOOTH_MS, 1);
        var ease = p < 0.5 ? 2 * p * p : -1 + (4 - 2 * p) * p;
        el.scrollLeft = start + (end - start) * ease;
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function scheduleNext() {
      setTimeout(function () {
        if (!paused) smoothScrollBy(list, STEP_PX);
        scheduleNext();
      }, DELAY);
    }

    /* ── pausa/retomada por hover ── */
    list.addEventListener('mouseenter', function () { paused = true; });
    list.addEventListener('mouseleave', function () {
      if (!isDragging) paused = false;
    });

    /* ── drag com mouse (desktop) ── */
    var isDragging  = false;
    var dragStartX  = 0;
    var scrollStart = 0;
    var moved       = false;

    list.addEventListener('mousedown', function (e) {
      isDragging  = true;
      moved       = false;
      dragStartX  = e.clientX;
      scrollStart = list.scrollLeft;
      paused      = true;
      list.classList.add('fhb-dragging');
      clearTimeout(resumeTimer);
    });

    document.addEventListener('mousemove', function (e) {
      if (!isDragging) return;
      var dx = e.clientX - dragStartX;
      if (Math.abs(dx) > 3) moved = true;
      list.scrollLeft = scrollStart - dx;
    });

    document.addEventListener('mouseup', function () {
      if (!isDragging) return;
      isDragging = false;
      list.classList.remove('fhb-dragging');
      // retoma auto-scroll após RESUME_DELAY
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(function () { paused = false; }, RESUME_DELAY);
    });

    // Cancela o clique nos links se o usuário arrastou (evita navegação acidental)
    list.addEventListener('click', function (e) {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    }, true);

    /* ── touch: retoma após interação ── */
    list.addEventListener('touchstart', function () {
      paused = true;
      clearTimeout(resumeTimer);
    }, { passive: true });

    list.addEventListener('touchend', function () {
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(function () { paused = false; }, RESUME_DELAY);
    }, { passive: true });

    scheduleNext();
  }

  /* ──────────────────────────────────────────────
     Bootstrap
  ────────────────────────────────────────────── */
  function init() {
    if (document.getElementById(OVERLAY_ID)) return;
    var target = document.querySelector(TARGET_SEL);
    if (!target) return;
    injectStyles();
    injectBar(target);
  }

  function waitForTarget() {
    var el = document.querySelector(TARGET_SEL);
    if (el) {
      init();
      return;
    }
    var observer = new MutationObserver(function () {
      var found = document.querySelector(TARGET_SEL);
      if (found) {
        observer.disconnect();
        init();
      }
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForTarget);
  } else {
    waitForTarget();
  }
