      + '  font-weight:300; font-size:20px; line-height:109%; color:#FFFFFF; z-index:5;'
      + '}'

      // ===== CTA =====
      + '.at-dbh-cta {'
      + '  position:absolute; width:206.95px; height:49.13px;'
      + '  left:56.95px; top:270.42px;'
      + '  background:#5EDCFF; border-radius:45.28px; border:none;'
      + '  cursor:pointer; z-index:5;'
      + '  display:flex; align-items:center; justify-content:center;'
      + '  padding:0 30px; gap:5.66px;'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:700; font-size:19px; line-height:20px; color:#00043E;'
      + '  transition:transform 0.2s ease, box-shadow 0.2s ease;'
      + '}'
      + '.at-dbh-cta:hover {'
      + '  transform:translateY(-2px); box-shadow:0 4px 20px rgba(94,220,255,0.4);'
      + '}'

      // ===== LOGOS =====
      + '.at-dbh-logos {'
      + '  position:absolute; display:flex; align-items:center; gap:9px;'
      + '  width:125.65px; height:18.17px;'
      + '  left:calc(50% - 125.65px/2 - 13.09px); top:288.4px; z-index:5;'
      + '}'
      + '.at-dbh-logos-divider {'
      + '  width:0; height:18px; border-left:0.6px solid #FFFFFF; flex:none;'
      + '}'

      // ===== CONSULTE CONDICOES =====
      + '.at-dbh-consult {'
      + '  position:absolute; left:102.47px; top:329.43px;'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:400; font-size:12px; line-height:120%; color:#FFFFFF; z-index:5;'
      + '}'

      // ===== FOTO PERSONAGEM =====
      + '.at-dbh-photo-wrapper {'
      + '  position:absolute; width:350.12px; height:350.12px;'
      + '  left:443.99px; top:14.59px; z-index:3;'
      + '  border-radius:50%; overflow:hidden;'
      + '}'
      + '.at-dbh-photo-img {'
      + '  position:absolute; width:508px; height:489px;'
      + '  left:-113.95px; top:-27.88px;'
      + '  object-fit:cover;'
      + '}'
      + '.at-dbh-photo-gradient {'
      + '  position:absolute; bottom:0; left:0; width:100%; height:40%;'
      + '  background:linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.6) 100%);'
      + '  border-radius:0 0 175px 175px; z-index:4;'
      + '}'

      // ===== COPYRIGHT =====
      + '.at-dbh-copyright {'
      + '  position:absolute;'
      + '  left:calc(50% - 59px/2 + 259.05px); top:343.11px;'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:400; font-size:9px; line-height:7px;'
      + '  color:#FFFFFF; z-index:5; text-align:center;'
      + '}'

      // ===== BOTAO FECHAR =====
      + '.at-dbh-close {'
      + '  position:absolute; top:10px; right:10px; width:28px; height:28px;'
      + '  background:rgba(255,255,255,0.15); border:none; border-radius:50%;'
      + '  cursor:pointer; display:flex; align-items:center; justify-content:center;'
      + '  z-index:10; transition:background 0.2s ease;'
      + '}'
      + '.at-dbh-close:hover { background:rgba(255,255,255,0.3); }'
      + '.at-dbh-close svg { width:12px; height:12px; }'

      // ===== RESPONSIVO =====
      + '@media (max-width: 768px) {'
      + '  .at-dbh-container {'
