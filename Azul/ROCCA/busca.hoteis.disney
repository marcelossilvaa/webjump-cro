// =============================================================
// Personalizacao - Banner Disney na busca de hoteis
// Exibe banner promocional quando o usuario busca por termos
// relacionados a Disney na pagina de hoteis da Azul Viagens
// =============================================================
(function () {
  'use strict';

  // Configuracoes
  var EXPERIMENT_NAME = 'AT_Disney_busca_hoteis';
  var BANNER_LINK = 'https://www.voeazul.com.br/br/pt/disney/hoteis-disney?topic=Onde+Se+Hospedar&content=1%40Disney%27s+All-Star+Movies+Resort';
  var STYLE_ID = 'at-disney-busca-hoteis-style';
  var BANNER_ID = 'at-disney-busca-hoteis-banner';
  var EVAR84 = 'AT_Disney_busca_hoteis_campaign';
  var SESSION_KEY = 'at_disney_busca_hoteis_shown';

  // Controle de execucao
  var isProcessing = false;
  var debounceTimer = null;
  var bannerShown = false;

  // Termos relacionados a Disney para deteccao
  var DISNEY_TERMS = [
    'disney',
    'walt disney',
    'magic kingdom',
    'epcot',
    'animal kingdom',
    'hollywood studios',
    'all-star',
    'all star',
    'art of animation',
    'pop century',
    'contemporary resort',
    'polynesian',
    'grand floridian',
    'caribbean beach',
    'coronado springs',
    'boardwalk',
    'wilderness lodge',
    'saratoga springs',
    'riviera resort',
    'fort wilderness'
  ];

  // Verifica se ja exibiu nesta sessao
  function alreadyShownInSession() {
    try {
      return sessionStorage.getItem(SESSION_KEY) === 'true';
    } catch (e) {
      return false;
    }
  }

  function markShownInSession() {
    try {
      sessionStorage.setItem(SESSION_KEY, 'true');
    } catch (e) {
      // Sem suporte a sessionStorage, segue sem marcar
    }
  }

  // Verifica se o texto contem termos relacionados a Disney
  function containsDisneyTerm(text) {
    if (!text) return false;
    var lower = text.toLowerCase().trim();
    for (var i = 0; i < DISNEY_TERMS.length; i++) {
      if (lower.indexOf(DISNEY_TERMS[i]) !== -1) {
        return true;
      }
    }
    return false;
  }

  // Tracking Adobe Analytics
  function analyticsEvent(eventLabel, eventType) {
    if (!eventLabel) return;
    var labelEvent = EXPERIMENT_NAME + '_' + eventType + ' ' + eventLabel;
    console.log('[Tracking Disney Busca Hoteis] Evento disparado: ' + labelEvent);
    (function () {
      var s = window.s || (typeof s_gi === 'function' && s_gi('azul-novo-prod'));
      if (!s || typeof s.tl !== 'function') return;
      s.linkTrackVars = 'events,eVar82,eVar84';
      s.linkTrackEvents = 'event90';
      s.events = 'event90';
      s.eVar82 = labelEvent;
      s.eVar84 = EVAR84;
      s.tl(true, 'o', 'target_activity_action');
    })();
  }

  // Injeta CSS do banner
  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;

    var css = ''
      // ===== BANNER OVERLAY =====
      + '#' + BANNER_ID + ' {'
      + '  position:fixed; top:0; left:0; width:100%; height:100%;'
      + '  z-index:999998; display:flex; align-items:center; justify-content:center;'
      + '  background:rgba(0,0,0,0.7); opacity:0; transition:opacity 0.6s ease;'
      + '}'
      + '#' + BANNER_ID + '.at-dbh-visible { opacity:1; }'
      + '#' + BANNER_ID + '.at-dbh-fade-out { opacity:0; pointer-events:none; }'

      // ===== CONTAINER PRINCIPAL 720x386 =====
      + '.at-dbh-container {'
      + '  position:relative; width:720px; height:386px;'
      + '  background:#0150B5; border-radius:16px; overflow:hidden;'
      + '  box-shadow:0 20px 80px rgba(0,0,0,0.5);'
      + '  animation:atDbhBannerIn 0.6s ease-out forwards;'
      + '}'
      + '@keyframes atDbhBannerIn {'
      + '  0%{transform:scale(0.8) translateY(30px);opacity:0}'
      + '  100%{transform:scale(1) translateY(0);opacity:1}'
      + '}'

      // ===== CAMADAS DE BRILHO =====
      + '.at-dbh-glow-layer {'
      + '  position:absolute; pointer-events:none;'
      + '  background:radial-gradient(ellipse at center, rgba(100,180,255,0.18) 0%, rgba(50,130,255,0.08) 30%, transparent 70%);'
      + '  mix-blend-mode:plus-lighter;'
      + '}'
      + '.at-dbh-glow-1 {'
      + '  width:548px; height:548px;'
      + '  left:23.93%; top:148.95px;'
      + '  transform:rotate(164.96deg);'
      + '}'
      + '.at-dbh-glow-2 {'
      + '  width:548px; height:548px;'
      + '  left:-97.75%; top:306.49px;'
      + '  transform:rotate(164.96deg);'
      + '}'

      // ===== BRILHOS PONTUAIS =====
      + '.at-dbh-lens-flare {'
      + '  position:absolute; pointer-events:none; mix-blend-mode:screen;'
      + '  background:radial-gradient(ellipse at center, rgba(255,255,255,0.35) 0%, rgba(200,230,255,0.12) 30%, transparent 60%);'
      + '}'
      + '.at-dbh-lens-1 {'
      + '  width:200px; height:180px;'
      + '  left:-34.23%; top:-74.54%;'
      + '  transform:rotate(103.19deg);'
      + '}'
      + '.at-dbh-lens-2 {'
      + '  width:220px; height:200px;'
      + '  left:44.25%; top:23.17%;'
      + '  transform:rotate(131.48deg);'
