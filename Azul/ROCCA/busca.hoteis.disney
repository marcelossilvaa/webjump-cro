      + '}'

      // ===== FRAME OFERTA =====
      + '.at-dbh-offer-frame {'
      + '  position:absolute; box-sizing:border-box;'
      + '  width:365.61px; height:112.66px;'
      + '  left:58.19px; top:123.84px;'
      + '  border:1px solid #FFFFFF; border-radius:13px;'
      + '  z-index:5;'
      + '}'

      // ===== TEXTOS DE PRECO =====
      + '.at-dbh-desconto {'
      + '  position:absolute;'
      + '  left:calc(50% - 153.61px/2 - 210.24px); top:calc(50% - 39px/2 - 34.83px);'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:700; font-size:33px; line-height:120%; color:#FFFFFF; z-index:5;'
      + '}'
      + '.at-dbh-de {'
      + '  position:absolute;'
      + '  left:calc(50% - 26.67px/2 - 271.61px); top:calc(50% - 27px/2 - 7.36px);'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:300; font-size:22px; line-height:120%; color:#FFFFFF; z-index:5;'
      + '}'
      + '.at-dbh-rs {'
      + '  position:absolute;'
      + '  left:calc(50% - 28.57px/2 - 270.65px); top:calc(50% - 24px/2 + 11.43px);'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:700; font-size:20px; line-height:120%; color:#FFFFFF; z-index:5;'
      + '}'
      + '.at-dbh-preco {'
      + '  position:absolute;'
      + '  left:calc(50% - 121.16px/2 - 194.02px); top:calc(50% - 57px/2 + 1.58px);'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
      + '  font-weight:700; font-size:47px; line-height:120%; color:#FFFFFF; z-index:5;'
      + '}'
      + '.at-dbh-asterisco {'
      + '  position:absolute; left:224.53px; top:174.89px;'
      + '  font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;'
