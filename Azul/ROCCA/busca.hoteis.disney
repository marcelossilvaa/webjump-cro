    var style = document.createElement('style');
    style.id = STYLE_ID;
    style.type = 'text/css';
    if (style.styleSheet) {
      style.styleSheet.cssText = css;
    } else {
      style.appendChild(document.createTextNode(css));
    }
    document.head.appendChild(style);
  }

  // Cria e exibe o banner Disney Hoteis
  function createBanner() {
    if (document.getElementById(BANNER_ID)) return;

    var bannerOverlay = document.createElement('div');
    bannerOverlay.id = BANNER_ID;

    // Container principal 720x386
    var container = document.createElement('div');
    container.className = 'at-dbh-container';

    // Camadas de brilho
    var g1 = document.createElement('div');
    g1.className = 'at-dbh-glow-layer at-dbh-glow-1';
    container.appendChild(g1);

    var g2 = document.createElement('div');
    g2.className = 'at-dbh-glow-layer at-dbh-glow-2';
    container.appendChild(g2);

    // Lens flares
    var lf1 = document.createElement('div');
    lf1.className = 'at-dbh-lens-flare at-dbh-lens-1';
    container.appendChild(lf1);

    var lf2 = document.createElement('div');
    lf2.className = 'at-dbh-lens-flare at-dbh-lens-2';
    container.appendChild(lf2);

    var lf3 = document.createElement('div');
    lf3.className = 'at-dbh-lens-flare at-dbh-lens-3';
    container.appendChild(lf3);

    // Estrelinhas piscando
    var sparkleLayer = document.createElement('div');
    sparkleLayer.className = 'at-dbh-sparkle-layer';
    for (var i = 0; i < 20; i++) {
      var sh = document.createElement('div');
      sh.className = 'at-dbh-shine';
      sh.style.cssText = 'left:' + (Math.random() * 100) + '%;top:' + (Math.random() * 100) + '%;'
        + 'animation-delay:' + (Math.random() * 3) + 's;animation-duration:' + (1.5 + Math.random() * 2) + 's;';
      sparkleLayer.appendChild(sh);
    }
    container.appendChild(sparkleLayer);

    // Botao fechar
    var closeBtn = document.createElement('button');
    closeBtn.className = 'at-dbh-close';
    closeBtn.setAttribute('aria-label', 'Fechar');
    closeBtn.innerHTML = '<svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">'
      + '<path d="M1 1L13 13M13 1L1 13" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>';
    container.appendChild(closeBtn);

    // Titulo
    var txt = document.createElement('div');
    txt.className = 'at-dbh-txt';
    txt.textContent = 'Conhe\u00E7a os Hot\u00E9is Resort Disney';
    container.appendChild(txt);

    // Frame oferta
    var offerFrame = document.createElement('div');
    offerFrame.className = 'at-dbh-offer-frame';
    container.appendChild(offerFrame);

    // Textos de preco
    var desconto = document.createElement('div');
    desconto.className = 'at-dbh-desconto';
    desconto.textContent = 'Desconto';
    container.appendChild(desconto);

    var de = document.createElement('div');
    de.className = 'at-dbh-de';
    de.textContent = 'de';
    container.appendChild(de);

    var rs = document.createElement('div');
    rs.className = 'at-dbh-rs';
    rs.textContent = 'R$';
    container.appendChild(rs);

    var preco = document.createElement('div');
    preco.className = 'at-dbh-preco';
    preco.textContent = '2.300';
    container.appendChild(preco);

    var asterisco = document.createElement('div');
    asterisco.className = 'at-dbh-asterisco';
    asterisco.textContent = '*';
    container.appendChild(asterisco);

    var hoteisTxt = document.createElement('div');
    hoteisTxt.className = 'at-dbh-hoteis-txt';
    hoteisTxt.textContent = 'em Hot\u00E9is Resort Disney a partir de 4 noites';
    container.appendChild(hoteisTxt);

    // CTA
    var cta = document.createElement('button');
    cta.className = 'at-dbh-cta';
    cta.textContent = 'Eu quero';
    container.appendChild(cta);

    // Logos Azul Viagens | Disney Destinations
    var logos = document.createElement('div');
    logos.className = 'at-dbh-logos';

    var logoAzul = document.createElement('div');
    logoAzul.innerHTML = '<svg width="40" height="18" viewBox="0 0 40 18" fill="none" xmlns="http://www.w3.org/2000/svg">'
      + '<text x="0" y="12" font-family="Helvetica Neue,Arial,sans-serif" font-weight="700" font-size="8" fill="#FFFFFF">Azul</text>'
      + '<text x="0" y="18" font-family="Helvetica Neue,Arial,sans-serif" font-weight="400" font-size="6" fill="#FFFFFF">Viagens</text>'
      + '</svg>';
    logos.appendChild(logoAzul);

    var logoDivider = document.createElement('div');
    logoDivider.className = 'at-dbh-logos-divider';
    logos.appendChild(logoDivider);

    var logoDisney = document.createElement('div');
    logoDisney.innerHTML = '<svg width="70" height="12" viewBox="0 0 70 12" fill="none" xmlns="http://www.w3.org/2000/svg">'
      + '<text x="0" y="10" font-family="Helvetica Neue,Arial,sans-serif" font-weight="400" font-size="8" fill="#FFFFFF" letter-spacing="0.5">Disney Destinations</text>'
      + '</svg>';
    logos.appendChild(logoDisney);
    container.appendChild(logos);

    // Consulte condicoes
    var consult = document.createElement('div');
    consult.className = 'at-dbh-consult';
    consult.textContent = '*Consulte condi\u00E7\u00F5es.';
    container.appendChild(consult);

    // Foto personagem (circulo grande)
    var photoWrap = document.createElement('div');
    photoWrap.className = 'at-dbh-photo-wrapper';

    var photoImg = document.createElement('img');
    photoImg.className = 'at-dbh-photo-img';
    photoImg.src = 'https://i.imgur.com/iLqzxWT.png';
    photoImg.alt = 'Disney';
    photoWrap.appendChild(photoImg);

    var photoGrad = document.createElement('div');
    photoGrad.className = 'at-dbh-photo-gradient';
    photoWrap.appendChild(photoGrad);
    container.appendChild(photoWrap);

    // Copyright
    var copy = document.createElement('div');
    copy.className = 'at-dbh-copyright';
    copy.textContent = '\u00A9 2026 Disney';
    container.appendChild(copy);

    // Monta tudo
    bannerOverlay.appendChild(container);
    document.body.appendChild(bannerOverlay);

    requestAnimationFrame(function () {
      bannerOverlay.classList.add('at-dbh-visible');
    });

    // Tracking de visualizacao
    analyticsEvent('banner_disney_busca_hoteis', 'view');

    // Evento CTA - direciona para pagina de hoteis Disney
    cta.addEventListener('click', function (e) {
      e.stopPropagation();
      analyticsEvent('banner_disney_busca_hoteis_cta', 'click');
      window.location.href = BANNER_LINK;
    });

    // Clique no container (exceto fechar e CTA) - direciona para hoteis Disney
    container.addEventListener('click', function (e) {
      if (e.target === closeBtn || closeBtn.contains(e.target)) return;
      if (e.target === cta) return;
      e.stopPropagation();
      analyticsEvent('banner_disney_busca_hoteis_container', 'click');
      window.location.href = BANNER_LINK;
    });

    // Fechar banner - usuario ve os resultados normais
    closeBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      analyticsEvent('banner_disney_busca_hoteis_fechar', 'click');
      closeBanner(bannerOverlay);
    });

    // Clique no overlay (fora do banner) - fecha
    bannerOverlay.addEventListener('click', function (e) {
      if (e.target === bannerOverlay) {
        analyticsEvent('banner_disney_busca_hoteis_overlay_fechar', 'click');
        closeBanner(bannerOverlay);
      }
    });

    // Tecla Escape fecha o banner
    var handleEsc = function (e) {
      if (e.key === 'Escape') {
        analyticsEvent('banner_disney_busca_hoteis_esc_fechar', 'click');
        closeBanner(bannerOverlay);
        document.removeEventListener('keydown', handleEsc);
      }
    };
    document.addEventListener('keydown', handleEsc);
  }

  // Fecha o banner com fade-out
  function closeBanner(el) {
    if (!el) return;
    el.classList.add('at-dbh-fade-out');
    setTimeout(function () {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 600);
  }

  // Verifica se o destino exibido na pagina contem termo Disney
  function checkDestinyText() {
    // Seletor do nome do destino na pagina de resultados de hoteis
    var destinyEl = document.querySelector('.styles__ItemTitle-sc-1uec0uv-3 b');
    if (!destinyEl) {
      // Fallback para mobile
      destinyEl = document.querySelector('.styles__ItemTitle-sc-1uec0uv-3');
    }
    if (destinyEl && containsDisneyTerm(destinyEl.textContent)) {
      return true;
    }
    return false;
  }

  // Verifica inputs de busca na pagina por termos Disney
  function checkSearchInputs() {
    var inputs = document.querySelectorAll('input[type="text"], input[type="search"], input:not([type])');
    for (var i = 0; i < inputs.length; i++) {
      var val = inputs[i].value || '';
      if (containsDisneyTerm(val)) {
        return true;
      }
    }
    return false;
  }

  // Verifica a URL por termos Disney (parametros de busca)
  function checkUrlForDisney() {
    var url = window.location.href.toLowerCase();
    if (url.indexOf('disney') !== -1) {
      return true;
    }
    // Verifica parametros de busca decodificados
    try {
      var decoded = decodeURIComponent(url);
      if (decoded.indexOf('disney') !== -1) {
        return true;
      }
    } catch (e) {
      // URL invalida, ignora
    }
    return false;
  }

  // Verifica sugestoes de autocomplete visiveis
  function checkAutocompleteSuggestions() {
    var suggestions = document.querySelectorAll('[role="option"], [role="listbox"] li, .autocomplete-suggestion, .suggestion-item');
    for (var i = 0; i < suggestions.length; i++) {
      var text = suggestions[i].textContent || '';
      if (containsDisneyTerm(text)) {
        return true;
      }
    }
    return false;
  }

  // Funcao principal de deteccao
  function detectDisneySearch() {
    if (isProcessing || bannerShown) return;
    isProcessing = true;

    var isDisneySearch = checkUrlForDisney() || checkDestinyText() || checkSearchInputs();

    if (isDisneySearch) {
      console.log('[Disney Busca Hoteis] Busca relacionada a Disney detectada.');
      bannerShown = true;
      markShownInSession();
      injectStyles();
      createBanner();
    }

    isProcessing = false;
  }

  // Configura listeners nos inputs de busca
  function setupInputListeners() {
    var inputs = document.querySelectorAll('input[type="text"], input[type="search"], input:not([type])');
    inputs.forEach(function (input) {
      if (input.hasAttribute('data-dbh-listener-added')) return;
      input.setAttribute('data-dbh-listener-added', 'true');

      input.addEventListener('input', function () {
        if (bannerShown) return;
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
          if (containsDisneyTerm(input.value)) {
            // Aguarda um pouco para o usuario terminar de digitar
            setTimeout(function () {
              if (containsDisneyTerm(input.value)) {
                detectDisneySearch();
              }
            }, 800);
          }
        }, 300);
      });
    });
  }

  // Configura MutationObserver para detectar mudancas no DOM
  function setupObserver() {
    if (window._atDisneyBuscaHoteisObserver) return;

    var observer = new MutationObserver(function (mutations) {
      if (bannerShown || isProcessing) return;

      // Ignora mudancas causadas pelo proprio banner
      var isBannerChange = mutations.some(function (mutation) {
        var addedNodes = Array.from(mutation.addedNodes);
        return addedNodes.some(function (node) {
          return node.nodeType === 1 && (
            node.id === BANNER_ID ||
            node.id === STYLE_ID ||
            (node.querySelector && node.querySelector('#' + BANNER_ID))
          );
        });
      });

      if (isBannerChange) return;

      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () {
        // Reaplica listeners em novos inputs
        setupInputListeners();
        // Verifica se destino Disney apareceu nos resultados
        detectDisneySearch();
      }, 500);
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
      characterData: true
    });

    window._atDisneyBuscaHoteisObserver = observer;
    console.log('[Disney Busca Hoteis] Observer configurado.');
  }

  // Funcao de inicializacao
  function init() {
    // Verifica se ja exibiu nesta sessao
    if (alreadyShownInSession()) {
      console.log('[Disney Busca Hoteis] Banner ja exibido nesta sessao, ignorando.');
      return;
    }

    // Verifica se estamos na pagina de hoteis
    var url = window.location.href.toLowerCase();
    var isHotelPage = url.indexOf('/hoteis') !== -1
      || url.indexOf('/hotel') !== -1
      || url.indexOf('hoteis-disney') !== -1;

    if (!isHotelPage) {
      console.log('[Disney Busca Hoteis] Pagina nao e de hoteis, ignorando.');
      return;
    }

    console.log('[Disney Busca Hoteis] Inicializando na pagina de hoteis.');

    // Verifica imediatamente se ja tem conteudo Disney na pagina
    detectDisneySearch();

    // Se ainda nao mostrou, configura listeners e observer
    if (!bannerShown) {
      setupInputListeners();
      setupObserver();
    }
  }

  // Inicializar quando DOM estiver pronto
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
