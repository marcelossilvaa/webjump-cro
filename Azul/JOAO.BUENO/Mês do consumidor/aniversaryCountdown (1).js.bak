                    'display: flex;' +
                    'justify-content: center;' +
                    'align-items: center;' +
                    'width: 100%;' +
                    'height: 56px;' +
                    'background: #FF0A8C;' +
                    'box-shadow: 0px 10px 15px -3px rgba(0, 0, 0, 0.1), 0px 4px 6px -4px rgba(0, 0, 0, 0.1);' +
                    'border-radius: 24px;' +
                    'border: none;' +
                    'cursor: pointer;' +
                    'text-decoration: none;' +
                    'font-family: "Helvetica Neue", Arial, sans-serif;' +
                    'font-weight: 700;' +
                    'font-size: 16px;' +
                    'line-height: 24px;' +
                    'text-align: center;' +
                    'color: #FFFFFF;' +
                    'text-transform: uppercase;' +
                    'transition: opacity 0.3s ease;' +
                '}' +
                '.modalInjected__cta:hover {' +
                    'opacity: 0.9;' +
                '}' +
                '.modalInjected__dismiss {' +
                    'display: flex;' +
                    'justify-content: center;' +
                    'align-items: center;' +
                    'width: 100%;' +
                    'padding: 16px 0px 30px 0px;' +
                    'border: none;' +
                    'cursor: pointer;' +
                    'background: transparent;' +
                    'font-family: "Helvetica Neue", Arial, sans-serif;' +
                    'font-weight: 400;' +
                    'font-size: 14px;' +
                    'line-height: 21px;' +
                    'text-align: center;' +
                    'color: #FFFFFF;' +
                '}' +
                '@media screen and (max-width: 540px) {' +
                    '.modalInjected__title {' +
                        'font-size: 24px;' +
                        'line-height: 32px;' +
                    '}' +
                    '.modalInjected__logos {' +
                        'gap: 12px;' +
                    '}' +
                    '.modalInjected__countdown__data {' +
                        'width: 60px;' +
                    '}' +
                '}';
            document.head.appendChild(style);
        }

        // ===== VERIFICACAO DE URL DESABILITADA PARA TESTE =====
        function onTargetPage() {
            return true;
        }

        if (window.mesDoConsumidorModal || !onTargetPage()) {
            console.log("[AT] Page is not a correct page OR script already executed.");
            return;
        }

        window.mesDoConsumidorModal = true;
        checkIfDomReady();
    })();
