                    'margin: 10px;' +
                '}' +
                '.modalInjected__header {' +
                    'display: flex;' +
                    'flex-direction: row;' +
                    'justify-content: space-between;' +
                    'align-items: flex-start;' +
                    'padding: 24px;' +
                    'width: 100%;' +
                '}' +
                '.modalInjected__headerContent {' +
                    'flex: 1;' +
                '}' +
                '.modalInjected__badge {' +
                    'position: relative;' +
                    'display: inline-flex;' +
                    'align-items: center;' +
                    'justify-content: center;' +
                    'width: 200px;' +
                    'height: 36px;' +
                    'margin-bottom: 16px;' +
                '}' +
                '.modalInjected__badgeBg {' +
                    'position: absolute;' +
                    'inset: 0;' +
                    'background: #FF0A8C;' +
                    'border-radius: 65.71px;' +
                    'z-index: 0;' +
                '}' +
                '.modalInjected__badgeBg::before {' +
                    'content: "";' +
                    'position: absolute;' +
