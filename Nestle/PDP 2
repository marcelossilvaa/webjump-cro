			subscriptionInfo.addEventListener('click', function (event) {
				event.preventDefault();
				analyticsEvent('assinatura_como_funciona', 'clique');
				pushDataLayerEvent('nestle_pdp_fold1_subscription_info_click', {});
			});
		}

		const offerCards = root.querySelectorAll('[data-wj-offer]');
		let i = 0;
		while (i < offerCards.length) {
			const offer = offerCards[i];
			if (!offer.getAttribute('data-wj-listener-added')) {
				offer.setAttribute('data-wj-listener-added', 'true');
				offer.addEventListener('click', function () {
					const mode = offer.getAttribute('data-wj-offer') || 'single';
					applyOfferMode(root, mode);
					analyticsEvent('modo_' + mode, 'clique');
					pushDataLayerEvent('nestle_pdp_fold1_mode_change', { mode: mode });
				});
			}
			i = i + 1;
		}

		const typeContainer = root.querySelector('[data-wj-chip-group="type"]');
		if (typeContainer) {
			renderTypeChips(typeContainer);
		}

		const packageContainer = root.querySelector('[data-wj-chip-group="package"]');
		if (packageContainer) {
			renderChips(packageContainer, PACKAGE_OPTIONS, selectedPackage, 'package');
		}

		const comboContainer = root.querySelector('[data-wj-chip-group="combo"]');
		if (comboContainer) {
			renderChips(comboContainer, COMBO_OPTIONS, selectedCombo, 'combo');
		}

		const chips = root.querySelectorAll('.wj-fold1-chip');
		i = 0;
		while (i < chips.length) {
			const chip = chips[i];
			if (!chip.getAttribute('data-wj-listener-added')) {
				chip.setAttribute('data-wj-listener-added', 'true');
				chip.addEventListener('click', function () {
					const group = chip.getAttribute('data-wj-chip') || '';

					if (group === 'type') {
						const key = chip.getAttribute('data-wj-key') || '';
						if (key && key !== selectedType) {
							selectedType = key;
							analyticsEvent('tipo_' + key, 'clique');
							pushDataLayerEvent('nestle_pdp_fold1_type_click', { type: key });
						}
					}

					if (group === 'package') {
						const value = chip.getAttribute('data-wj-value') || '';
						if (value) {
							selectedPackage = value;
							analyticsEvent('embalagem_' + normalizeText(value), 'clique');
							pushDataLayerEvent('nestle_pdp_fold1_package_click', { package: value });
						}
					}

					if (group === 'combo') {
						const value = chip.getAttribute('data-wj-value') || '';
						if (value) {
							selectedCombo = value;
							analyticsEvent('combo_' + normalizeText(value), 'clique');
							pushDataLayerEvent('nestle_pdp_fold1_combo_click', { combo: value });
						}
					}

					resolveProductUrl($, selectedType, selectedPackage, selectedCombo, function (resolvedUrl) {
						if (!resolvedUrl) {
							return;
						}

						const currentPath = normalizeText(window.location.pathname || '');
						if (normalizeText(resolvedUrl) === currentPath) {
							return;
						}

						window.location.href = resolvedUrl;
					});
				});
			}
			i = i + 1;
		}

		const qtyValueElement = root.querySelector('[data-wj-qty-value="true"]');
		const minusButton = root.querySelector('[data-wj-qty="minus"]');
		const plusButton = root.querySelector('[data-wj-qty="plus"]');
		let qty = 1;

		const renderQty = function () {
			if (!qtyValueElement) {
				return;
			}

			if (qty <= 1) {
				qtyValueElement.textContent = '1 unidade';
			} else {
				qtyValueElement.textContent = qty + ' unidades';
			}
		};

		renderQty();

		if (minusButton && !minusButton.getAttribute('data-wj-listener-added')) {
			minusButton.setAttribute('data-wj-listener-added', 'true');
			minusButton.addEventListener('click', function () {
				qty = Math.max(1, qty - 1);
				renderQty();
			});
		}

		if (plusButton && !plusButton.getAttribute('data-wj-listener-added')) {
			plusButton.setAttribute('data-wj-listener-added', 'true');
			plusButton.addEventListener('click', function () {
				qty = qty + 1;
				renderQty();
			});
		}

		const cta = root.querySelector('[data-wj-action="add-to-cart"]');
		if (cta && !cta.getAttribute('data-wj-listener-added')) {
			cta.setAttribute('data-wj-listener-added', 'true');
			cta.addEventListener('click', function () {
				const currentMode = cta.getAttribute('data-wj-mode') || selectedPurchaseMode;
				const originalButton = document.querySelector('#product-addtocart-button');
				const qtyInput = document.querySelector('input[name="qty"]');

				analyticsEvent('add_to_cart_' + currentMode, 'clique');
				pushDataLayerEvent('nestle_pdp_fold1_add_to_cart_click', {
					mode: currentMode,
					type: selectedType,
					package: selectedPackage,
					combo: selectedCombo,
					quantity: qty
				});

				if (qtyInput) {
					qtyInput.value = String(qty);
					qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
				}

				if (originalButton) {
					originalButton.click();
				}
			});
		}
	}

	function applyFold1($) {
		if (isProcessing) {
			return;
		}

		isProcessing = true;

		try {
			const target = getTargetContainer();
			if (!target) {
				return;
			}

			const title = getTitle();
			const reviewText = getReviewText();
			const priceText = getPriceText();
			const oldPriceText = getOldPriceText();

			parseSelectionsFromContext(title);
			injectStyles();

			let root = document.getElementById(ROOT_ID);
			if (!root) {
				root = document.createElement('section');
				root.id = ROOT_ID;
				root.setAttribute('data-wj-fold1-initialized', 'true');

				const anchor = target.querySelector('.product-add-form') || target.querySelector('.box-tocart') || target.firstChild;
				if (anchor && anchor.parentNode) {
					anchor.parentNode.insertBefore(root, anchor);
				} else {
					target.appendChild(root);
				}
			}

			hideNativeTopElements();
			root.innerHTML = buildRootHtml(title, reviewText, priceText, oldPriceText);
			addInteractionListeners(root, $);

			analyticsEvent('componente_primeira_dobra', 'visualizacao');
			pushDataLayerEvent('nestle_pdp_fold1_view', {
				title: title,
				price: priceText
			});
		} finally {
			isProcessing = false;
		}
	}

	function scheduleApply($) {
		if (applyDebounceTimer) {
			clearTimeout(applyDebounceTimer);
		}

		applyDebounceTimer = setTimeout(function () {
			applyFold1($);
		}, APPLY_DEBOUNCE_MS);
	}

	function setupObserver($) {
		if (window._wjNestlePdpFold1Observer) {
			return;
		}

		const observer = new MutationObserver(function (mutations) {
			if (isProcessing) {
				return;
			}

			let shouldApply = false;
			let i = 0;
			while (i < mutations.length) {
				const mutation = mutations[i];
				if (mutation.type === 'childList' && mutation.addedNodes && mutation.addedNodes.length) {
					shouldApply = true;
					break;
				}
				i = i + 1;
			}

			if (shouldApply) {
				scheduleApply($);
			}
		});

		observer.observe(document.body, {
			childList: true,
			subtree: true
		});

		window._wjNestlePdpFold1Observer = observer;
	}

	function attemptInit() {
		require(['jquery', 'domReady!'], function ($) {
			const target = getTargetContainer();
			if (!target) {
				initAttempts = initAttempts + 1;
				if (initAttempts >= MAX_INIT_ATTEMPTS && initTimer) {
					clearInterval(initTimer);
					initTimer = null;
				}
				return;
			}

			applyFold1($);
			setupObserver($);

			if (initTimer) {
				clearInterval(initTimer);
				initTimer = null;
			}
		});
	}

	function init() {
		attemptInit();

		if (initTimer) {
			clearInterval(initTimer);
		}

		initTimer = setInterval(function () {
			if (initAttempts >= MAX_INIT_ATTEMPTS) {
				clearInterval(initTimer);
				initTimer = null;
				return;
			}

			attemptInit();
		}, INIT_INTERVAL_MS);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function () {
			init();
		});
	} else {
		init();
	}
})();
