	function applyOfferMode(root, mode) {
		const offers = root.querySelectorAll('[data-wj-offer]');
		let i = 0;
		while (i < offers.length) {
			const offer = offers[i];
			if (offer.getAttribute('data-wj-offer') === mode) {
				offer.classList.add('active');
			} else {
				offer.classList.remove('active');
			}
			i = i + 1;
		}

		selectedPurchaseMode = mode;
		const cta = root.querySelector('[data-wj-action="add-to-cart"]');
		if (cta) {
			cta.setAttribute('data-wj-mode', mode);
		}
	}

	function scoreProductItem(item, typeKey, packageValue, comboValue) {
		const itemName = normalizeText(item && item.name ? item.name : '');
		const itemMeta = normalizeText(item && item.meta_title ? item.meta_title : '');
		const text = itemName + ' ' + itemMeta;
		let score = 0;

		if (typeKey === 'comfor' && text.indexOf('comfor') !== -1) {
			score = score + 40;
		}

		if (typeKey === 'supremepro' && text.indexOf('supreme') !== -1) {
			score = score + 40;
		}

		if (packageValue && text.indexOf(normalizeText(packageValue)) !== -1) {
			score = score + 35;
		}

		if (comboValue) {
			const comboNormalized = normalizeText(comboValue);
			if (comboNormalized === 'leve 2' && (text.indexOf('leve 2') !== -1 || text.indexOf('kit 2') !== -1)) {
				score = score + 30;
			}

			if (comboNormalized === 'leve 3' && (text.indexOf('leve 3') !== -1 || text.indexOf('kit 3') !== -1)) {
				score = score + 30;
			}
		}

		return score;
	}

	function resolveProductUrl($, typeKey, packageValue, comboValue, onDone) {
		const option = TYPE_OPTIONS.find(function (item) {
			return item.key === typeKey;
		});

		if (!option) {
			onDone('');
			return;
		}

		const searchText = option.label + ' ' + packageValue + ' ' + comboValue;

		$.ajax({
			url: '/graphql',
			method: 'POST',
			contentType: 'application/json',
			dataType: 'json',
			data: JSON.stringify({
				query: PRODUCT_URL_SEARCH_QUERY,
				variables: { search: searchText }
			})
		})
			.done(function (response) {
				const items = response && response.data && response.data.products && response.data.products.items ? response.data.products.items : [];
				let best = null;
				let bestScore = -1;
				let i = 0;

				while (i < items.length) {
					const score = scoreProductItem(items[i], typeKey, packageValue, comboValue);
					if (score > bestScore) {
						bestScore = score;
						best = items[i];
					}
					i = i + 1;
				}

				if (best && best.url_key) {
					onDone('/' + best.url_key + (best.url_suffix || ''));
					return;
				}

				onDone(option.fallbackUrl);
			})
			.fail(function () {
				onDone(option.fallbackUrl);
			});
	}

